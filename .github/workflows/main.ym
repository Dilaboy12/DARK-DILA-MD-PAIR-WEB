name: DARK DILA-MD WhatsApp Bot

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

concurrency:
  group: dark-dila-md-bot
  cancel-in-progress: true

jobs:
  start-bot:
    name: Start DARK DILA-MD
    runs-on: ubuntu-latest
    timeout-minutes: 350

    env:
      NODE_ENV: production
      OWNER_NUMBER: ${{ secrets.OWNER_NUMBER }}
      PAIRING_NUMBER: ${{ secrets.PAIRING_NUMBER }}
      SESSION_ID: ${{ secrets.SESSION_ID }}
      MEGA_EMAIL: ${{ secrets.MEGA_EMAIL }}
      MEGA_PASSWORD: ${{ secrets.MEGA_PASSWORD }}

    steps:
      # Checkout repository
      - name: Checkout Repository
        uses: actions/checkout@v4

      # Setup Node.js
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "20"

      # Install dependencies
      - name: Install Dependencies
        run: |
          npm install --legacy-peer-deps --no-audit --no-fund
          npm ls megajs
          npm ls @whiskeysockets/baileys

      # Create required folders
      - name: Create Directories
        run: |
          mkdir -p session
          mkdir -p plugins
          mkdir -p data

      # Validate configuration
      - name: Validate Configuration
        run: |
          node -e "require('./config'); console.log('Config loaded successfully')"
          node -e "require('./mega'); console.log('MEGA module loaded successfully')"
          echo "Configuration validation completed."

      # Check Session configuration
      - name: Check Session
        run: |
          if [ -n "$SESSION_ID" ]; then
            echo "Existing MEGA session detected."
          else
            echo "No SESSION_ID found."
            echo "Fresh Pair Code login will be required."
          fi

      # Start WhatsApp Bot
      - name: Start DARK DILA-MD
        run: |
          echo "=================================="
          echo "       DARK DILA-MD START"
          echo "=================================="

          set +e
          timeout 340m npm start
          STATUS=$?
          set -e

          if [ "$STATUS" -eq 124 ]; then
            echo "Bot runtime limit reached."
          elif [ "$STATUS" -ne 0 ]; then
            echo "Bot stopped with error: $STATUS"
            exit "$STATUS"
          else
            echo "Bot stopped normally."
          fi

      # Finish
      - name: Bot Status
        if: always()
        run: |
          echo "=================================="
          echo "DARK DILA-MD workflow finished."
          echo "=================================="
